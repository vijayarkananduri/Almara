<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_folder_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="#FFFAF5EB">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Virtual folders"
        android:textColor="#FF332F29" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_folder_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="#FF6C675F" android:textSize="13sp" />
    <TextView android:id="@+id/widget_folder_1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="#FF48643E" android:textSize="14sp"
        android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_folder_2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="#FF48643E" android:textSize="14sp"
        android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_folder_3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="#FF48643E" android:textSize="14sp"
        android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_folder_4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="#FF48643E" android:textSize="14sp"
        android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_folder_5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="#FF48643E" android:textSize="14sp"
        android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
